load("@rules_go//go:def.bzl", "go_binary")
load("@gazelle//:def.bzl", "gazelle")

# Expose the ghostty cc_library at the root so external repos (like the
# go_deps-fetched libghostty) can reference it via @@//third_party:ghostty_vt.
alias(
    name = "ghostty_vt",
    actual = "//third_party:ghostty_vt",
    visibility = ["//visibility:public"],
)

# Keep the gazelle:prefix in sync with go.mod module path.
# gazelle:prefix github.com/AgentDrasil/agent-wrapper

# Run `bazel run //:gazelle` to regenerate BUILD files from go.mod.
# Run `bazel run //:gazelle -- -mode diff` to preview changes.
gazelle(name = "gazelle")

# ── Main binary ───────────────────────────────────────────────────────────────
# agent-wrapper is a CGO binary that embeds libghostty's VT state machine.
# The C dependency (libghostty-vt.a) is declared in //out/ghostty:ghostty_vt.
# Run `just build-libghostty` first to populate out/ghostty/ if it is missing.
go_binary(
    name = "agent_wrapper",
    srcs = ["main.go"],
    cgo  = True,
    # Link the pre-built libghostty-vt static library.
    cdeps = ["//out/ghostty:ghostty_vt"],
    # Needed so that the CGO preamble's #include <ghostty/vt.h> resolves.
    copts = ["-DGHOSTTY_STATIC"],
    deps = [
        "@com_github_creack_pty//:go_default_library",
        "@com_mitchellh_go_libghostty//:go_default_library",
    ],
    visibility = ["//visibility:public"],
)
