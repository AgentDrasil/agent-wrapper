module(
    name = "agent_wrapper",
    version = "0.0.0",
)

# ── Core rule sets ─────────────────────────────────────────────────────────────
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.43.0")
bazel_dep(name = "rules_zig", version = "0.16.0")
bazel_dep(name = "rules_cc",  version = "0.2.18")

# ── Go SDK ─────────────────────────────────────────────────────────────────────
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

# ── Go module dependencies (sourced from go.mod / go.sum) ─────────────────────
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_creack_pty",
    "com_mitchellh_go_libghostty",
)

# Override the auto-generated BUILD file for libghostty so that Bazel knows it
# needs to link against our pre-built libghostty-vt static library (cdeps).
# Without this, CGO compilation fails because the ghostty headers aren't visible.
go_deps.module_override(
    path = "go.mitchellh.com/libghostty",
    patches = ["//third_party/go_libghostty_patches:libghostty_cdeps.patch"],
    patch_strip = 1,
)

# ── Zig toolchain ──────────────────────────────────────────────────────────────
# Download the exact Zig version required by ghostty's build.zig.zon so that
# the same compiler is used both for libghostty-vt (via Docker / just) and for
# CGO compilation of the Go binary.
zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.toolchain(zig_version = "0.15.2")  # matches ghostty minimum_zig_version
