# =========================================================
# STAGE 1: Build libghostty-vt using the correct Zig version
# =========================================================
FROM debian:13-slim AS builder

RUN apt-get update && apt-get install -y \
    curl \
    xz-utils \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY third_party/ghostty /src

# Dynamically download the exact required Zig version and build
RUN export ZIG_VERSION=$(sed -n -E 's/^\s*\.?minimum_zig_version\s*=\s*"([^"]+)".*/\1/p' build.zig.zon) && \
    curl -L -o /tmp/zig.tar.xz "https://ziglang.org/download/$ZIG_VERSION/zig-$(uname -m)-linux-$ZIG_VERSION.tar.xz" && \
    tar -xf /tmp/zig.tar.xz -C /opt && \
    rm /tmp/zig.tar.xz && \
    ln -s "/opt/zig-$(uname -m)-linux-$ZIG_VERSION/zig" /usr/local/bin/zig

RUN --mount=type=tmpfs,target=/root/.cache \
    zig build \
    -Demit-lib-vt \
    -Dtarget=x86_64-linux-gnu \
    -Doptimize=ReleaseFast \
    --prefix /ghostty-dist

# =========================================================
# STAGE 2: Export only the built artifacts to host filesystem
# =========================================================
FROM scratch
COPY --from=builder /ghostty-dist/ /
